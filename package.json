{
  "name": "growsafe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GrowSafe: a free child-safety planner (installable web app).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "kb:validate": "tsx scripts/validate-kb.ts && tsx scripts/validate-help.ts",
    "plan:demo": "tsx scripts/print-plan.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "fflate": "0.8.2",
    "idb-keyval": "6.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.27.0",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@eslint/js": "9.13.0",
    "@playwright/test": "1.48.2",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "eslint": "9.13.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.11.0",
    "jsdom": "25.0.1",
    "prettier": "3.3.3",
    "tsx": "^4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.12.2",
    "vite": "5.4.10",
    "vite-plugin-pwa": "0.20.5",
    "vitest": "2.1.4"
  }
}
