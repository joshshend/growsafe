# Copy to .env (git-ignored) if you need it. No secrets belong in this app.

# Public URL of the deployed web app, e.g. https://growsafe.vercel.app
# Used so links created inside a native (Capacitor) build point at the web app
# instead of capacitor://localhost. Optional: the web build does not need it.
VITE_PUBLIC_URL=

# Photo scan (server side only; set in Vercel > Settings > Environment Variables, or in .env.local for `npm run dev`).
# Never prefix these with VITE_ and never commit them. Set ONE key; if both are set, Gemini is used.
GEMINI_API_KEY=
# Default: gemini-3.8-flash (a Flash-class model listed on ai.google.dev/models on 2026-10-24)
GEMINI_MODEL=
ANTHROPIC_API_KEY=
# Default: claude-haiku-5-5. claude-sonnet-5-5 is the stronger, costlier option.
ANTHROPIC_MODEL=
# Max scans per day across all users (default 300)
DAILY_CAP=
